# --- Plaid ---------------------------------------------------------------
# Get these from https://dashboard.plaid.com/developers/keys
PLAID_CLIENT_ID=
PLAID_SECRET=
# sandbox | production   (Plaid retired "development"; use sandbox to test)
PLAID_ENV=sandbox
# Public HTTPS URL Plaid can POST webhooks to, e.g. https://money.example.com/api/plaid/webhook
# Leave blank to rely on the scheduled syncs + "Sync now" button only.
PLAID_WEBHOOK_URL=
# Country codes for Link (comma separated)
PLAID_COUNTRY_CODES=US

# --- Security ------------------------------------------------------------
# Password for the dashboard login screen. Required.
APP_PASSWORD=change-me
# 32+ random characters. Used to sign the login cookie and encrypt Plaid
# access tokens at rest. Generate one with:  openssl rand -hex 32
APP_SECRET=

# --- Scheduling ----------------------------------------------------------
# Cron for full refresh (balances, transactions, investments). Default: 7am & 7pm.
SYNC_CRON=0 7,19 * * *
# Time zone used by the scheduler
TZ=America/New_York

# --- Storage -------------------------------------------------------------
# SQLite file location (default ./data/finance.db)
DATABASE_PATH=./data/finance.db
